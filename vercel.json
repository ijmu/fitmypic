{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/image-resizer.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/compress-image.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/social-media-image-sizes.html",
      "destination": "/resize-image-for-instagram.html",
      "permanent": true
    },
    {
      "source": "/image-file-size-guide.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/resize-without-losing-quality.html",
      "destination": "/image-output-testing.html",
      "permanent": true
    },
    {
      "source": "/zh",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zh/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zh/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zh/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
